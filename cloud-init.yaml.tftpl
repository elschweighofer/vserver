#cloud-config
# Forwards public ports 80 and 443 to the home webserver over WireGuard. The
# home machine dials out to this server, so it needs no port opened on its NAT.
# Runs on first boot only; any change here makes Terraform replace the server.
package_update: true
packages:
  - haproxy
  - nftables
  - unattended-upgrades
  - wireguard

write_files:
  # Security updates run daily, and a reboot follows the next night if one is
  # needed. Times are UTC, and 03:31 falls between the monitor's 5-minute checks.
  - path: /etc/apt/apt.conf.d/52unattended-upgrades-local
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "03:31";

  # Mirrors the Hetzner firewall. SSH is closed everywhere, including the tunnel.
  - path: /etc/nftables.conf
    defer: true
    content: |
      flush ruleset

      table inet filter {
        chain input {
          type filter hook input priority filter; policy drop;

          ct state established,related accept
          ct state invalid drop
          iif "lo" accept

          tcp dport { 80, 443 } accept
          udp dport ${wg_port} accept
          iifname "wg0" meta l4proto { icmp, ipv6-icmp } accept

          # Needed for the public network itself to keep working.
          udp sport 67 udp dport 68 accept
          icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept
        }

        chain forward {
          type filter hook forward priority filter; policy drop;
        }

        chain output {
          type filter hook output priority filter; policy accept;
        }
      }

  - path: /etc/wireguard/wg0.conf
    permissions: "0600"
    defer: true
    content: |
      [Interface]
      Address = ${wg_server_address}/24
      ListenPort = ${wg_port}
      PrivateKey = ${wg_server_private_key}

      [Peer]
      PublicKey = ${wg_home_public_key}
      AllowedIPs = ${wg_home_address}/32

  # Raw TCP forwarding: TLS and certificates stay on the home webserver.
  - path: /etc/haproxy/haproxy.cfg
    defer: true
    content: |
      global
        log /dev/log local0
        user haproxy
        group haproxy
        daemon

      defaults
        log global
        mode tcp
        option tcplog
        timeout connect 5s
        timeout client 1h
        timeout server 1h

      frontend http
        bind :::80 v4v6
        default_backend home_http

      frontend https
        bind :::443 v4v6
        default_backend home_https

      backend home_http
        server home ${wg_home_address}:80

      backend home_https
        server home ${wg_home_address}:443

runcmd:
  - systemctl enable --now nftables
  - systemctl enable --now wg-quick@wg0
  - systemctl restart haproxy
  # Ubuntu starts sshd from a socket, so both units must go.
  - systemctl disable --now ssh.socket ssh.service
